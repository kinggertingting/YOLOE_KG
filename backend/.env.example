# ==========================================
# YOLOE-KG-CLIP Backend Environment Config Template
# ==========================================

# Hardware Execution Device ("auto", "cpu", or GPU index e.g., "0")
DEVICE=auto

# Model Identifiers & Paths
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
# YOLOE_PATH=models/yoloe-26m-seg.pt
# KG_PATH=data/KG.json

# Detection & Image Parameters
IMGSZ=640
CONF_THRESHOLD=0.03
EVAL_CONF=0.25
IOU_THR=0.50

# Multi-Modal Fusion Hyperparameters
ALPHA=0.75
LOW_CONF_THR=0.30
IOU_NMS=0.70

# Knowledge Graph Relation Filters (comma-separated)
USEFUL_RELATIONS=isa,atlocation

# Video Rendering Codec (e.g., mp4v, avc1)
VIDEO_CODEC=mp4v

# Public Base URL (optional, e.g. http://localhost:8000 or https://yoloe.duckdns.org)
PUBLIC_BASE_URL=http://localhost:8000

# Target Classes List (comma-separated)
TARGET_CLASSES=person,rider,car,bus,truck,bike,motor,traffic light,traffic sign,train,pedestrian,cyclist,van,road,lane,crosswalk,intersection,vehicle,parking lot,railway,bridge,barrier,tree,animal
